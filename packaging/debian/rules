#!/usr/bin/make -f
# the themes are generated by make-icons.py and kept in the repository: nothing to build

%:
	dh $@

override_dh_auto_build:

override_dh_auto_install:
	for theme in NeoLine NeoLine-White NeoLine-Yellow; do \
	    mkdir -p debian/neoline-icons/usr/share/icons; \
	    cp -a $$theme debian/neoline-icons/usr/share/icons/; \
	    sed -i 's/^Inherits=.*/Inherits=breeze-dark,breeze,Adwaita,hicolor/' debian/neoline-icons/usr/share/icons/$$theme/index.theme; \
	done

# (thousands of small SVGs: compressing or stripping has nothing to do)
override_dh_compress:
	dh_compress -X.svg
