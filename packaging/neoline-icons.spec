%global commit      e8beedf1119bb54ebadba66353473eb9db46a518
%global shortcommit %(c=%{commit}; echo ${c:0:7})
%global snapdate    202611141208

Name:           neoline-icons
Version:        1.0^%{snapdate}git%{shortcommit}
Release:        1%{?dist}
Summary:        Outline icon theme in the style of Dolphin NG
License:        MIT
URL:            https://github.com/Morzilla/neoline-icons
Source0:        %{url}/archive/%{commit}/neoline-icons-%{shortcommit}.tar.gz
BuildArch:      noarch
Requires:       breeze-icon-theme

%description
NeoLine is an outline icon theme drawn on a 24 px grid with a round 1.7 px
stroke. Actions follow the colour scheme; places and file types are drawn in
the colour of their kind. It comes in three variants (NeoLine, NeoLine White,
NeoLine Yellow) and inherits Breeze for every icon it does not draw.

%prep
%autosetup -n neoline-icons-%{commit}

%build
# the themes are generated by make-icons.py and kept in the repository

%install
mkdir -p %{buildroot}%{_datadir}/icons
for theme in NeoLine NeoLine-White NeoLine-Yellow; do
    cp -a $theme %{buildroot}%{_datadir}/icons/
    # fall back on the Breeze themes every system has
    sed -i 's/^Inherits=.*/Inherits=breeze-dark,breeze,Adwaita,hicolor/' %{buildroot}%{_datadir}/icons/$theme/index.theme
done

%files
%license LICENSE
%doc README.md
%{_datadir}/icons/NeoLine
%{_datadir}/icons/NeoLine-White
%{_datadir}/icons/NeoLine-Yellow

